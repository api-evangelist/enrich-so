     "name": "Invite someone to your team",
     "request": {
      "name": "Invite someone to your team",
      "description": {
       "content": "Sends an email invitation to join your team. You must be an **admin** or\n**owner** to invite people. The invitee can be assigned the role of `admin`\nor `member`.",
